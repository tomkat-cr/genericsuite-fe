{
  "name": "genericsuite",
  "version": "1.2.0",
  "description": "The GenericSuite for ReactJS (frontend version)",
  "author": "Carlos J. Ramirez",
  "license": "MIT",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "scripts",
    "Makefile",
    "webpack.config.js",
    "config-overrides.js",
    "vite.config.mjs",
    "index.html",
    "jest.config.cjs",
    "setupTests.js",
    ".env.example",
    "CHANGELOG.md",
    "public/gs_core.css",
    "src/lib/images",
    "src/lib/helpers/IconsLib.jsx",
    "src/lib/constants/class_name_constants.jsx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomkat-cr/genericsuite-fe.git"
  },
  "bugs": {
    "url": "https://github.com/tomkat-cr/genericsuite-fe/issues"
  },
  "homepage": "https://genericsuite.carlosjramirez.com/Frontend-Development/GenericSuite-Core/",
  "keywords": [
    "genericsuite",
    "generic-crud",
    "menu-builder",
    "security-builder",
    "react",
    "reactjs"
  ],
  "scripts": {
    "start": "node server.js",
    "start-build": "./node_modules/react-app-rewired/bin/react-app-rewired.js build && node server.js",
    "start-debug": "ls -lah && node server.js",
    "start-dev": "react-app-rewired start",
    "start-dev-webpack": "npx webpack-dev-server --config webpack.config.js",
    "start-dev-vite": "npx vite dev",
    "build-prod": "webpack --mode production",
    "heroku-postbuild": "npm run build",
    "build-dev": "react-app-rewired build",
    "build": "rm -rf dist && rollup -c",
    "eject-dev": "react-scripts eject",
    "test-dev": "react-app-rewired test",
    "test": "jest",
    "//": "See https://stackoverflow.com/questions/70368760/react-uncaught-referenceerror-process-is-not-defined",
    "// preinstall": "npx npm-force-resolutions",
    "predeploy": "npm run build",
    "deploy": "# gh-pages -d build # Uncomment this line to deploy to github pages and run 'npm install -D gh-pages'",
    "check-types": "tsc --noEmit"
  },
  "resolutions": {
    "//": "See https://github.com/facebook/create-react-app/issues/11773",
    "react-error-overlay": "6.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.0-placeholder-for-preset-env.2",
    "@babel/plugin-syntax-jsx": "^7.23.3",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.3",
    "@types/react": "^18.2.63",
    "autoprefixer": "^10.4.16",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.0.0",
    "babel-plugin-css-modules-transform": "^1.6.2",
    "baseline-browser-mapping": "^2.9.19",
    "genericsuite-fe-scripts": "github:tomkat-cr/genericsuite-fe-scripts#develop",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.25",
    "react-test-renderer": "^18.2.0",
    "rollup": "^4.59.0",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svg": "^2.0.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.3.3",
    "whatwg-fetch": "^3.6.20"
  },
  "peerDependencies": {
    "axios": "^1.19.0",
    "bson": "7.2.0",
    "buffer": "^6.0.3",
    "downshift": "^9.4.0",
    "formik": "^2.4.9",
    "history": "^4.9.0",
    "js-md5": "^0.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-overlay": "6.0.9",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "rxjs": "^6.3.3",
    "yup": "^1.7.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "engines": {
    "node": ">= 18.12.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "browser": {
    "fs": false
  },
  "overrides": {
    "elliptic": "^6.6.1",
    "json5": "^1.0.2",
    "minimatch": "^10.2.1",
    "postcss": "$postcss",
    "loader-utils": "^2.0.4"
  }
}
